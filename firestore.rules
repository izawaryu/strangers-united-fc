rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read/write only to the club's season registration collection
    // with basic document structure validation (replaces expiring 30-day Test Mode rule)
    match /registrations_winter_2026/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'name', 'paid'])
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 100
                            && request.resource.data.paid is bool;
      allow delete: if true;
    }

    // Deny access to all other arbitrary collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
